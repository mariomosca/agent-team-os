#!/usr/bin/env bash
# pre-commit (RS07-F4.1): AGENT_MAP.json, personas/*.md and agenti.json are generated by Roster, not edited.
# A commit that stages one of them is accepted only with a `.roster-export.json` in the same folder (staged or
# already tracked) whose entry for that file matches its content: the ETag Roster gave is "<version>.<12 hex>",
# the 12 hex being the start of the SHA-256 of the file. A hand edit does not match, so it is refused.
# Not covered: examples/ (documentation), and the hand-kept personas listed in HAND_MANAGED below.
set -u
# Brandart personas are not exported yet (no DPA): they stay hand-written. Remove a line when Roster exports it.
HAND_MANAGED=("personas/teo.md")

bad=0
while IFS= read -r f; do
  case "$f" in examples/*|*/examples/*) continue ;; esac
  base="${f##*/}"
  case "$base" in
    AGENT_MAP.json|agenti.json) ;;
    *.md) [[ "$f" =~ (^|/)personas/[^/]+\.md$ ]] || continue ;;
    *) continue ;;
  esac
  skip=0; for h in ${HAND_MANAGED[@]+"${HAND_MANAGED[@]}"}; do [[ "$f" == "$h" ]] && skip=1; done
  [[ $skip == 1 ]] && continue
  dir="${f%/*}"; [[ "$dir" == "$f" ]] && dir="."
  meta="$dir/.roster-export.json"; [[ "$dir" == "." ]] && meta=".roster-export.json"
  # a deletion is always fine
  git cat-file -e ":$f" 2>/dev/null || continue
  sum="$(git show ":$f" | shasum -a 256 | cut -c1-12)"
  etag="$(git show ":$meta" 2>/dev/null | python3 -c '
import json,sys
try: print(json.load(sys.stdin)["files"].get(sys.argv[1],{}).get("etag") or "")
except Exception: print("")' "$base")"
  if [[ -z "$etag" ]]; then
    echo "pre-commit: $f e' generato da Roster ma manca $meta con la sua voce." >&2; bad=1
  elif [[ "$etag" != *".$sum"* ]]; then
    echo "pre-commit: $f non corrisponde all'export di Roster (hash $sum, registrato $etag)." >&2; bad=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ $bad == 1 ]]; then
  cat >&2 <<'MSG'

Questi file non si modificano a mano: li genera Roster (rosterhq.io).
Per cambiare un agente (nome, voce, persona, regole di cartella) modificalo in Roster, dal portale o dal MCP,
poi lancia `roster export all` (o aspetta il LaunchAgent, 10 minuti) e fai il commit del file generato
insieme al suo .roster-export.json. Vedi docs/ROSTER-EXPORT.md.
MSG
  exit 1
fi
exit 0
