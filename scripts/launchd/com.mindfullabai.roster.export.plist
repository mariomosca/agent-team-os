<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  RS07-F4.1: every 10 minutes `roster export all` writes AGENT_MAP.json, personas, agenti.json and avatars from
  Roster (rosterhq.io). Fail-open: with Roster down the files stay. Installed by scripts/install-roster-export.sh,
  which copies roster-export.sh to ~/.local/share/roster/ so the job does not depend on a checkout.
  Stop it: launchctl bootout gui/$(id -u)/com.mindfullabai.roster.export (the files stay, edit them by hand again).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mindfullabai.roster.export</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.local/share/roster/roster-export.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/roster-export.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/roster-export.launchd.log</string>
</dict>
</plist>
