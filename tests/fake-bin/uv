#!/bin/bash
# Fake uv for test-custode.sh.
#   ... python -c ...            prints FAKE_UV_PYTHON (default 3.12.7)
#   ... -m agent_bus_mcp.server  a stdio MCP server: answers initialize and
#                                tools/list one line at a time, exits on EOF
#                                (like the real one: close stdin early = no answer).
#   FAKE_MCP_MODE=ok (default) | broken (traceback on stderr, exit 1) | few (4 tools)
#   ... centralino status        the stats of a centralino; FAKE_CENTRALINO=down: not answering
args=" $* "
[[ "$1" == sync ]] && exit 0
if [[ "$args" == *" centralino status "* ]]; then
  [[ "${FAKE_CENTRALINO:-ok}" == down ]] && { echo "il centralino del bus non risponde su /x/centralino.sock" >&2; exit 2; }
  echo '{"ping":{"ok":true},"stats":{"ok":true,"result":{"messaggi":12,"pending":2,"sessioni_vive":1}}}'; exit 0
fi
if [[ "$args" == *" -c "* ]]; then
  [[ "${FAKE_UV_PYTHON:-3.12.7}" == none ]] && { echo "error: No interpreter found" >&2; exit 2; }
  echo "${FAKE_UV_PYTHON:-3.12.7}"; exit 0
fi
if [[ "$args" == *"agent_bus_mcp.server"* ]]; then
  if [[ "${FAKE_MCP_MODE:-ok}" == broken ]]; then
    echo "Traceback (most recent call last):" >&2
    echo "ImportError: cannot import name 'beartype' (Python 3.15)" >&2
    exit 1
  fi
  tools='["bus_close","bus_inbox","bus_read","bus_reply","bus_send","bus_status"]'
  [[ "${FAKE_MCP_MODE:-ok}" == few ]] && tools='["bus_inbox","bus_read","bus_send","bus_status"]'
  echo "fastmcp banner" >&2
  while IFS= read -r line; do
    id=$(printf '%s' "$line" | jq -r '.id // empty')
    m=$(printf '%s' "$line" | jq -r '.method')
    case "$m" in
      initialize) jq -cn --argjson id "$id" '{jsonrpc:"2.0",id:$id,result:{protocolVersion:"2025-06-18",capabilities:{tools:{}},serverInfo:{name:"agent-bus",version:"0"}}}' ;;
      tools/list) jq -cn --argjson id "$id" --argjson t "$tools" '{jsonrpc:"2.0",id:$id,result:{tools:[$t[]|{name:.,inputSchema:{type:"object"}}]}}' ;;
    esac
  done
  exit 0
fi
echo "fake uv: unexpected args: $*" >&2; exit 2
