{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/agent-team-os-load.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/agent-team-os-urgent.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/agent-team-os-stop.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__onda__onda_agent_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/hooks/agent-team-os-onda-prompt.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__onda__onda_agent_spawn",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/hooks/agent-team-os-onda-spawn.py pre",
            "timeout": 6
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/agent-team-os-end.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__onda__onda_agent_spawn",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/hooks/agent-team-os-onda-spawn.py post",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
