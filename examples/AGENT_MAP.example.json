{
  "version": "2.0",
  "updated": "2026-06-06",
  "rules": [
    {
      "pattern": "/Users/me/work",
      "match": "prefix",
      "agent": "ops"
    },
    {
      "pattern": "/Users/me/projects",
      "match": "prefix",
      "agent": "dev"
    },
    {
      "pattern": "/Users/me/marketing",
