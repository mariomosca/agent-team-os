      "capabilities": [
        "planning",
        "tracking",
        "handoff",
        "question",
        "architecture-review"
      ],
      "persona_file": "personas/ops.md",
      "voice_id": "PS6wM7QnnPTUDE3t4bbl",
      "voice_name": "Serena",
      "is_god": true,
      "domain": "side",
      "task_provider": "orbit"
    },
    "dev": {
      "display_name": "Dev",
      "role": "Engineer",
      "capabilities": [
        "bug-fix",
        "feature-spec",
        "code-review",
        "refactor",
        "handoff",
        "question",
        "generate-screenshots"
      ],
      "persona_file": "personas/dev.md",
      "voice_id": "W71zT1VwIFFx3mMGH2uZ",
      "voice_name": "MarcoTrox",
      "god": "ops",
      "domain": "side"
    },
    "growth": {
      "display_name": "Growth",
      "role": "Content and marketing",
      "capabilities": [
        "draft-post",
        "review-copy",
        "plan-campaign",
        "handoff",
        "question"
      ],
      "persona_file": "personas/growth.md",
      "voice_id": "Dzlw1nIlAqiOOW6J7qo1",
      "voice_name": "Chiara",
      "god": "ops",
      "domain": "side"
