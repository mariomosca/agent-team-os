  "routing_rules": {
    "ops": {
      "deny": [],
      "reason": "ops is the hub, can talk to anyone"
    },
    "dev": {
      "deny": [],
      "reason": "dev can talk to ops and growth"
    },
    "growth": {
      "deny": [],
      "reason": "growth can talk to ops and dev"
    }
  },
  "_v2_note": "v2.0 adds: gods[] (list of orchestrator agents), per-agent domain + god + optional task_provider. GOD agents drive a TaskProvider (orbit/pmohub) per domain. See PLAN-AGENT-TEAM-OS.md v2.0."
